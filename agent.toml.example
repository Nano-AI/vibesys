[model]
name = "claude-sonnet-4-6"
# provider = "vertex-ai"    # vertex-ai, anthropic, google-genai (auto-detected if omitted)

# [thinking]
# level = "medium"          # minimal, low, medium, high (Gemini 3+ models)
# budget = 1024             # token budget (Gemini 2.5 models, -1 for dynamic)

# [providers.vertex-ai]
# json = "~/keys/vertex.json"
# project = "my-project"
# region = "us-east5"

# [providers.anthropic]
# uses ANTHROPIC_API_KEY env var

# [providers.google-genai]
# uses GOOGLE_API_KEY env var

# [agent]
# Selects which agent backend the loop drives. The default is
# "deepagents", which uses langchain + deepagents. Setting backend = "cli"
# instead drives an external coding-agent CLI (Claude Code, Gemini, Codex,
# or Opencode) via vibe_database/_agent_cli.
#
# CLI flags --agent-backend / --cli-provider override these values.
# backend = "deepagents"      # or "cli"
# cli_provider = "claude"     # required when backend = "cli";
                              # one of: claude, gemini, codex, opencode
# cli_timeout = 1800          # per-iteration timeout in seconds (default: no timeout)

# [backend]
# Compute backend the synthesized query engine targets. Supported values:
#   "cpu"  — compiled query engines run locally on CPU (the default).
#
# CLI flag --backend overrides this value.
# name = "cpu"
